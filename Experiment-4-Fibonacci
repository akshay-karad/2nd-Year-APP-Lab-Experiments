# Experiment 4: Fibonacci using Dynamic Programming

def fibonacci_memoization(n, memo={}):
    if n == 0:
        return 0
    if n == 1:
        return 1

    if n not in memo:
        memo[n] = (fibonacci_memoization(n - 1, memo) +
                   fibonacci_memoization(n - 2, memo))

    return memo[n]


def fibonacci_tabulation(n):
    if n == 0:
        return 0
    if n == 1:
        return 1

    dp = [0] * (n + 1)
    dp[0] = 0
    dp[1] = 1

    for i in range(2, n + 1):
        dp[i] = dp[i - 1] + dp[i - 2]

    return dp[n]


# Main program
n = int(input("Enter the value of n: "))

print("Fibonacci using Memoization:", fibonacci_memoization(n))
print("Fibonacci using Tabulation:", fibonacci_tabulation(n))